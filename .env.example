# คัดลอกเป็น .env แล้วแก้รหัสผ่าน (ไฟล์ .env ไม่ถูก commit)

# superuser ของ Postgres — ใช้แค่ตอนสร้าง container ครั้งแรก (_entrypoint/init.sh)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser

POSTGRES_DB=mydb
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# user ที่แอปใช้จริง (สิทธิ์จำกัด) — init.sh สร้างให้ตอนสร้าง volume ครั้งแรก
# Backend/.env ต้องใช้ค่าเดียวกัน
POSTGRES_APP_USER=appuser
POSTGRES_APP_PASSWORD=change-me-app
